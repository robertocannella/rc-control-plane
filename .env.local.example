# Generate with: openssl rand -base64 33
AUTH_SECRET=

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Needed locally so @google-cloud/firestore knows which project to use
# (Cloud Run infers this automatically in production). Also requires
# running: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
